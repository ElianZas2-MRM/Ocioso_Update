# Virtual environment
venv/

# Python cache
__pycache__/
*.py[cod]
*$py.class

# IDEs
.vscode/
.idea/

# Runtime data
temporales/
# Todo lo que produce la app (leads, LambdaTest Mac/Android, dealers,
# revision masiva) vive adentro de resultados/, asi que con esta linea alcanza.
resultados/
json/programacion_test.json
json/programacion_leads.json
json/programacion_masivo.json
json/scheduler_triggered.json
json/dealer_comparator_settings.json

# OS files
.DS_Store
Thumbs.db

# Credenciales sensibles - no versionar
lambdatest_credentials.txt
config_global.json

# Excels reales de clientes (rankings/listados de dealers) - no versionar
*Ranking Dealers*.xls*

# Excels externos del CRM colocados en la raiz del proyecto - contienen datos de
# terceros, JAMAS versionar. Entradas especificas (no *.xlsx generico) porque
# data/Field_Validation_URLs.xlsx si debe seguir trackeado.
CRM - GMSA - Validaciones Formularios*.xlsx
/GM Forms - 2026.xlsx

# Excels de datos - se generan desde la app, no se versionan
data/Lead_information_*.xls*
data/Estado_Cidade_BR.xlsx
data/GM Forms*.xls*

# PyInstaller output — regenerable con build.bat
build/
dist/
build_output*.log

# Config local de Claude Code - no versionar
CLAUDE.md
.atl/

# Logs de ejecucion - se regeneran solos
debug_run.log
json/ejecutor_autonomo.log

# Outputs de LambdaTest (regenerables)
cta_evidence/
Ocioso_Update - COPIA_SEGURIDAD-VERSIONUNO/

# Salida local del diagnostico de LambdaTest (contiene usuario)
Diagnostico_LambdaTest_resultado.txt

# Excels de trabajo local (matriz de forms y datos de prueba) - no versionar
data/GM Forms*.xls*
data/FormsBolivia_TDP_test_data.xlsx

# Indice generado por CodeGraph (base SQLite + estado del daemon) - se regenera solo
.codegraph/

# Artefactos que deja pytest al correr
log/

# Drivers de navegador - los descarga y actualiza la app sola al iniciar
# (utils/driver_updater.py). Antes se versionaban aca: ~86 MB de binarios que ademas quedaban
# desfasados cada vez que Chrome/Edge se autoactualizaban y habia que reemplazar a mano.
drivers/
json/driver_check.json

# Binarios de driver, esten donde esten. Hasta ahora solo se ignoraba la carpeta
# drivers/, asi que una copia suelta en la raiz o dentro de otra carpeta se podia
# commitear sin que nada avisara — que es exactamente como llegaron los ~86 MB que
# hubo que purgar del historial en septiembre de 2026.
chromedriver*
geckodriver*
msedgedriver*
operadriver*
IEDriverServer*
selenium-manager*
*.exe

# Documentos pesados (guias, presentaciones). Van a SharePoint; en docs/ quedan los
# links. Un .docx ya viene comprimido, asi que git no lo puede delta-comprimir: cada
# version que se suba pesa entera y para siempre. El Guia_de_Uso_Osocio.docx que quedo
# en el historial son 12 versiones y 3,7 MB que ya no se pueden sacar sin volver a
# reescribir el historial, y eso obliga a todo el equipo a re-clonar.
#
# OJO: esto NO desversiona lo que ya estaba trackeado. Queda uno adentro de
# docs/como_se_usa/, y sigue igual: .gitignore solo aplica a archivos nuevos.
# Si alguna vez hace falta subir uno a proposito: git add -f <archivo>
*.docx
*.pptx
*.dotx
*.potx
